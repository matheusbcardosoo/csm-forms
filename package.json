{
  "name": "csm-forms",
  "version": "2.0.0",
  "description": "Secretaria Digital — Colégio São Marcos",
  "main": "server/index.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p client/tsconfig.json",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "puppeteer": "^25.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.23",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "puppeteer@25.5.0": true
  }
}
