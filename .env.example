# Copie este arquivo para .env (na raiz do projeto) e preencha com os
# dados da sua instância Supabase self-hosted. Depois rode:
#   sh scripts/generate-config.sh
# para gerar assets/js/config.js localmente.
#
# Em produção (EasyPanel), NÃO é preciso criar o .env: defina essas
# mesmas variáveis nas "Environment Variables" do app no painel do
# EasyPanel, e configure o Build Command como "sh scripts/generate-config.sh".

SUPABASE_URL=https://seu-supabase-selfhosted.exemplo.com
SUPABASE_ANON_KEY=sua-anon-key-aqui

# Usada só localmente, pelo scripts/provision-staff-users.mjs, pra criar
# as contas de login da equipe. NUNCA coloque essa chave no config.js
# nem em nada que vá para o navegador — ela ignora todo o RLS do banco.
# Fica em Project Settings > API > service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
