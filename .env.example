# Copie este arquivo para .env (na raiz do projeto) e preencha com os
# dados do seu projeto Supabase.
#
# Em produção (EasyPanel), NÃO é preciso criar o .env: defina essas
# mesmas variáveis nas "Environment Variables" do app.

SUPABASE_URL=https://seu-supabase-selfhosted.exemplo.com
SUPABASE_ANON_KEY=sua-anon-key-aqui

# Usada pelo scripts/provision-staff-users.mjs (criação de contas da
# equipe) e também pela própria aplicação, na rota interna de geração de
# PDF (routes/pdf.js). NUNCA coloque essa chave no config.js nem em nada
# que vá para o navegador — ela ignora todo o RLS do banco.
# Fica em Project Settings > API > service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Assina os cookies de sessão (httpOnly). Gere um valor aleatório longo.
COOKIE_SECRET=

# Porta do servidor Express (painel em /app, formulários em /).
PORT=3000

# URL base pela qual o próprio servidor se acessa — usada pelo Puppeteer
# (lib/pdf.js) pra renderizar a página do PDF. Em produção, normalmente é
# a URL pública da aplicação (ex.: https://formularios.saomarcos.com.br).
APP_BASE_URL=http://localhost:3000

# Segredo aleatório usado internamente pela aplicação para proteger a rota
# GET /internal/pdf/visita/:id (só o Puppeteer deve acessá-la). Gere um
# valor aleatório qualquer, ex.: `openssl rand -hex 32`.
INTERNAL_PDF_SECRET=

# URL do Webhook (node Webhook) do workflow n8n que recebe o PDF gerado
# automaticamente a cada nova visita registrada. Deixe em branco pra
# manter essa integração desligada.
N8N_WEBHOOK_URL=

# URL do Webhook do workflow n8n que recebe o PDF + anexo (atestado/
# comprovante) de cada requerimento de avaliação substitutiva, salva no
# Drive e notifica a coordenação do segmento (língua materna/inglesa).
# Deixe em branco pra manter essa integração desligada.
# Ex.: https://n8n.saomarcos.cloud/webhook/avaliacao-substitutiva-whatsapp/enviar
N8N_AVALIACAO_WEBHOOK_URL=
