<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Formulário de Visita | Colégio São Marcos</title>
<link rel="icon" type="image/png" href="/images/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<main class="page">
  <div class="wizard-card">

    <div style="text-align:center;margin-bottom:20px;align-items:center;display:flex;justify-content:center;">
      <img src="/images/logo.jpg" alt="Logotipo do Colégio São Marcos" class="header-logo">
    </div>

    <!-- STEP INDICATOR -->
    <div class="stepper" id="stepper" role="list" aria-label="Progresso do formulário">
      <div class="step-node" data-step="1" role="listitem">
        <div class="step-circle"><i class="fa-solid fa-user-graduate"></i></div>
        <span class="step-name">Aluno</span>
      </div>
      <div class="step-connector" data-connector="1"><span class="step-connector-fill"></span></div>

      <div class="step-node" data-step="2" role="listitem">
        <div class="step-circle"><i class="fa-solid fa-school"></i></div>
        <span class="step-name">Escola</span>
      </div>
      <div class="step-connector" data-connector="2"><span class="step-connector-fill"></span></div>

      <div class="step-node" data-step="3" role="listitem">
        <div class="step-circle"><i class="fa-solid fa-people-roof"></i></div>
        <span class="step-name">Responsáveis</span>
      </div>
      <div class="step-connector" data-connector="3"><span class="step-connector-fill"></span></div>

      <div class="step-node" data-step="4" role="listitem">
        <div class="step-circle"><i class="fa-solid fa-comment-dots"></i></div>
        <span class="step-name">Extras</span>
      </div>
      <div class="step-connector" data-connector="4"><span class="step-connector-fill"></span></div>

      <div class="step-node" data-step="5" role="listitem">
        <div class="step-circle"><i class="fa-solid fa-clipboard-check"></i></div>
        <span class="step-name">Revisão</span>
      </div>
    </div>
    <div class="wizard-step-label" id="step-label">Passo 1/5</div>

    <form id="visita-form" novalidate>

      <!-- ===================== STEP 1: ALUNO(S) ===================== -->
      <section class="wizard-step" data-step="1">
        <h2 class="wizard-title">Dados do aluno</h2>
        <p class="wizard-desc">Informe os dados do aluno interessado na vaga. Você pode adicionar mais de um aluno, se necessário.</p>

        <div id="students-container"></div>

        <button type="button" class="add-student-btn" id="add-student-btn">+ Adicionar mais um aluno</button>
      </section>

      <!-- ===================== STEP 2: ESCOLA DE ORIGEM ===================== -->
      <section class="wizard-step hidden" data-step="2">
        <h2 class="wizard-title">Escola de origem</h2>
        <p class="wizard-desc">Dados da escola em que o aluno está matriculado atualmente.</p>

        <div class="field-group">
          <label for="escola-nome">Nome da escola</label>
          <input type="text" id="escola-nome" name="escola-nome" placeholder="Ex: Colégio Exemplo">
          <div class="error-text"><i class="fa-solid fa-circle-exclamation"></i> Informe o nome da escola.</div>
        </div>

        <div class="field-group">
          <label for="escola-cidade">Cidade / Estado</label>
          <input type="text" id="escola-cidade" name="escola-cidade" placeholder="Ex: São Paulo / SP">
          <div class="error-text"><i class="fa-solid fa-circle-exclamation"></i> Informe a cidade e o estado.</div>
        </div>
      </section>

      <!-- ===================== STEP 3: RESPONSÁVEIS ===================== -->
      <section class="wizard-step hidden" data-step="3">
        <h2 class="wizard-title">Dados dos responsáveis</h2>
        <p class="wizard-desc">Informe os dados de contato do pai e da mãe (ou responsáveis).</p>

        <div class="student-block">
          <div class="student-block-header"><span>Pai</span></div>
          <div class="field-group">
            <label for="pai-nome">Nome completo</label>
            <input type="text" id="pai-nome" placeholder="Nome completo do pai">
            <div class="error-text"><i class="fa-solid fa-circle-exclamation"></i> Informe o nome completo (nome e sobrenome).</div>
          </div>
          <div class="field-row">
            <div class="field-group">
              <label for="pai-whatsapp">WhatsApp</label>
              <input type="tel" id="pai-whatsapp" inputmode="tel" placeholder="(11) 91234-5678 ou +1 234 567 8900">
              <div class="error-text"><i class="fa-solid fa-circle-exclamation"></i> Informe um telefone válido (nacional ou internacional).</div>
            </div>
            <div class="field-group">
              <label for="pai-profissao">Profissão</label>
              <input type="text" id="pai-profissao" placeholder="Ex: Engenheiro">
              <div class="error-text"><i class="fa-solid fa-circle-exclamation"></i> Informe a profissão.</div>
            </div>
          </div>
        </div>

        <div class="student-block">
          <div class="student-block-header"><span>Mãe</span></div>
          <div class="field-group">
            <label for="mae-nome">Nome completo</label>
            <input type="text" id="mae-nome" placeholder="Nome completo da mãe">
            <div class="error-text"><i class="fa-solid fa-circle-exclamation"></i> Informe o nome completo (nome e sobrenome).</div>
          </div>
          <div class="field-row">
            <div class="field-group">
              <label for="mae-whatsapp">WhatsApp</label>
              <input type="tel" id="mae-whatsapp" inputmode="tel" placeholder="(11) 91234-5678 ou +1 234 567 8900">
              <div class="error-text"><i class="fa-solid fa-circle-exclamation"></i> Informe um telefone válido (nacional ou internacional).</div>
            </div>
            <div class="field-group">
              <label for="mae-profissao">Profissão</label>
              <input type="text" id="mae-profissao" placeholder="Ex: Advogada">
              <div class="error-text"><i class="fa-solid fa-circle-exclamation"></i> Informe a profissão.</div>
            </div>
          </div>
        </div>
        <div class="hint">Preencha ao menos um dos responsáveis com todos os dados solicitados.</div>
        <div class="error-banner hidden" id="responsaveis-error">
          <i class="fa-solid fa-circle-exclamation"></i>
          Preencha ao menos os dados de um responsável (pai ou mãe).
        </div>
      </section>

      <!-- ===================== STEP 4: INFORMAÇÕES EXTRAS ===================== -->
      <section class="wizard-step hidden" data-step="4">
        <h2 class="wizard-title">Informações complementares</h2>
        <p class="wizard-desc">Nos ajude a entender melhor o seu contexto.</p>

        <div class="field-group">
          <label for="motivo">Qual o principal motivo que o trouxe até o Colégio São Marcos?</label>
          <textarea id="motivo" placeholder="Conte um pouco sobre o que motivou a busca pelo colégio"></textarea>
          <div class="error-text"><i class="fa-solid fa-circle-exclamation"></i> Conte um pouco sobre o motivo da visita.</div>
        </div>

        <div class="field-group">
          <span class="field-legend">Foi indicado por alguém?</span>
          <div class="choice-group" id="indicacao-choice">
            <button type="button" class="choice-pill" data-value="sim"><span class="check">✓</span> Sim</button>
            <button type="button" class="choice-pill" data-value="nao"><span class="check">✓</span> Não</button>
          </div>
          <div class="error-text"><i class="fa-solid fa-circle-exclamation"></i> Selecione uma opção.</div>
        </div>

        <div class="field-group hidden" id="indicacao-nome-group">
          <label for="indicacao-nome">Nome de quem indicou</label>
          <input type="text" id="indicacao-nome" placeholder="Nome completo da pessoa que indicou">
          <div class="error-text"><i class="fa-solid fa-circle-exclamation"></i> Informe o nome completo (nome e sobrenome).</div>
        </div>

        <div class="field-group">
          <label for="observacoes">Observações <span style="font-weight:400;color:var(--text-muted);">(opcional)</span></label>
          <textarea id="observacoes" placeholder="Se quiser, deixe alguma observação adicional"></textarea>
        </div>
      </section>

      <!-- ===================== STEP 5: REVISÃO ===================== -->
      <section class="wizard-step hidden" data-step="5">
        <h2 class="wizard-title">Revise suas respostas</h2>
        <p class="wizard-desc">Confira se está tudo certo antes de enviar.</p>

        <div id="review-container"></div>


        <!-- Consentimento LGPD -->
        <div class="field-group consent-group" id="consent-group">
          <label class="consent-label" for="consent-checkbox">
            <input type="checkbox" id="consent-checkbox">
            <span>
              Li e concordo com a
              <a href="#" class="policy-link" id="open-policy-link">Política de Privacidade</a>
              do Colégio São Marcos e autorizo o uso dos meus dados pessoais exclusivamente para fins administrativos internos da instituição, como elaboração de relatórios, solicitações de vaga e documentos institucionais.
            </span>
          </label>
          <div class="error-text">
            <i class="fa-solid fa-circle-exclamation"></i>
            É necessário aceitar a política de privacidade para enviar o formulário.
          </div>
        </div>

        <div class="error-banner hidden" id="submit-error">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <span id="submit-error-message">Não foi possível enviar o formulário. Verifique sua conexão e tente novamente.</span>
        </div>
      </section>

      <!-- ===================== SUCESSO ===================== -->
      <section class="wizard-step hidden" data-step="success">
        <div class="success-box">
          <div class="success-icon">✓</div>
          <h2 class="wizard-title">Formulário enviado!</h2>
          <p class="wizard-desc">Recebemos os dados da visita com sucesso. Em breve nossa equipe entrará em contato.</p>
          <a href="/form-visitas" id="success-back-link" class="btn btn-primary">Voltar ao início</a>
        </div>
      </section>

      <!-- ===================== NAV ===================== -->
      <div class="wizard-nav" id="wizard-nav">
        <button type="button" class="btn btn-secondary" id="back-btn">Voltar</button>
        <button type="button" class="btn btn-primary" id="next-btn">Próximo</button>
      </div>

    </form>
  </div>

  <!-- Modal Política de Privacidade -->
  <div id="policy-modal" class="modal hidden">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h2>Política de Privacidade e Tratamento de Dados</h2>
        <button type="button" class="modal-close" id="close-policy-modal" aria-label="Fechar">
          <i class="fa-solid fa-times"></i>
        </button>
      </div>
      <div class="modal-body">
        <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 20px;">
          Documento elaborado em conformidade com a Lei Geral de Proteção de Dados (Lei nº 13.709/2018 — LGPD).
        </p>

        <section class="policy-section">
          <h3><i class="fa-solid fa-school"></i> 1. Quem somos</h3>
          <p>
            O <strong>Colégio São Marcos</strong> é o controlador dos dados pessoais coletados por meio deste formulário de visita.
            Somos uma instituição de ensino privada localizada em Mogi das Cruzes — SP, comprometida com a transparência
            e com o uso ético das informações que nos são confiadas.
          </p>
        </section>

        <section class="policy-section">
          <h3><i class="fa-solid fa-list-check"></i> 2. Quais dados coletamos</h3>
          <p>Ao preencher o formulário de visita, coletamos as seguintes informações:</p>
          <ul>
            <li><strong>Dados do aluno:</strong> nome completo, data de nascimento e turma de interesse.</li>
            <li><strong>Escola de origem:</strong> nome da instituição e cidade/estado.</li>
            <li><strong>Dados dos responsáveis:</strong> nome completo, número de WhatsApp e profissão (pai e/ou mãe).</li>
            <li><strong>Informações contextuais:</strong> motivo da visita, indicação de terceiros e observações livres.</li>
          </ul>
        </section>

        <section class="policy-section">
          <h3><i class="fa-solid fa-bullseye"></i> 3. Para que usamos seus dados</h3>
          <p>Seus dados serão utilizados <strong>exclusivamente para finalidades administrativas internas</strong> do Colégio São Marcos, incluindo:</p>
          <ul>
            <li>Elaboração de relatórios internos de visitas e prospects.</li>
            <li>Preparação de documentos de solicitação de liberação de vaga.</li>
            <li>Elaboração de fichas e documentos para solicitação de desconto institucional.</li>
            <li>Contato pelos canais informados para dar continuidade ao processo de matrícula.</li>
            <li>Organização e controle interno do processo seletivo da instituição.</li>
          </ul>
          <p>Não utilizamos seus dados para fins comerciais, marketing de terceiros ou quaisquer outras finalidades além das listadas acima.</p>
        </section>

        <section class="policy-section">
          <h3><i class="fa-solid fa-scale-balanced"></i> 4. Base legal (LGPD)</h3>
          <p>O tratamento dos seus dados pessoais é fundamentado nas seguintes bases legais previstas no Art. 7º da Lei nº 13.709/2018:</p>
          <ul>
            <li><strong>Consentimento (inciso I):</strong> você autoriza expressamente o uso dos seus dados ao marcar a caixa de consentimento no formulário.</li>
            <li><strong>Legítimo interesse (inciso IX):</strong> o tratamento é necessário para a execução das atividades administrativas da instituição de ensino.</li>
          </ul>
        </section>

        <section class="policy-section">
          <h3><i class="fa-solid fa-share-nodes"></i> 5. Compartilhamento de dados</h3>
          <p>
            Os dados coletados <strong>não são compartilhados com terceiros</strong> para fins comerciais.
            O acesso é restrito aos colaboradores do Colégio São Marcos diretamente envolvidos no processo de matrícula e atendimento às famílias.
          </p>
        </section>

        <section class="policy-section">
          <h3><i class="fa-solid fa-clock"></i> 6. Prazo de retenção</h3>
          <p>
            Seus dados serão mantidos pelo período necessário à conclusão do processo de avaliação de matrícula e,
            posteriormente, pelo prazo mínimo exigido pela legislação brasileira aplicável.
            Após esse período, as informações serão eliminadas ou anonimizadas.
          </p>
        </section>

        <section class="policy-section">
          <h3><i class="fa-solid fa-shield-halved"></i> 7. Segurança dos dados</h3>
          <p>
            Adotamos medidas técnicas e administrativas adequadas para proteger seus dados contra acesso não autorizado,
            perda acidental, destruição ou divulgação indevida. O acesso às respostas do formulário é restrito
            por autenticação com senha individual aos colaboradores autorizados.
          </p>
        </section>

        <section class="policy-section">
          <h3><i class="fa-solid fa-user-check"></i> 8. Seus direitos como titular</h3>
          <p>Em conformidade com a LGPD, você tem direito a:</p>
          <ul>
            <li><strong>Acesso:</strong> saber quais dados seus estão armazenados.</li>
            <li><strong>Correção:</strong> solicitar a atualização de dados incorretos ou desatualizados.</li>
            <li><strong>Eliminação:</strong> pedir a exclusão dos seus dados, quando cabível.</li>
            <li><strong>Portabilidade:</strong> receber seus dados em formato estruturado.</li>
            <li><strong>Revogação do consentimento:</strong> retirar sua autorização a qualquer momento, sem prejuízo ao tratamento já realizado.</li>
          </ul>
        </section>

        <section class="policy-section">
          <h3><i class="fa-solid fa-envelope"></i> 9. Contato</h3>
          <p>
            Para exercer seus direitos ou esclarecer dúvidas sobre o tratamento dos seus dados, entre em contato com a secretaria do Colégio São Marcos:
          </p>
          <ul>
            <li><strong>Endereço:</strong> Mogi das Cruzes — SP</li>
            <li><strong>E-mail:</strong> <a href="mailto:secretaria@saomarcos.com.br">secretaria@saomarcos.com.br</a></li>
          </ul>
          <p style="margin-top:16px;font-size:13px;color:var(--text-muted);">
            Esta política pode ser atualizada periodicamente. Recomendamos que você a consulte antes de preencher novos formulários.
          </p>
        </section>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" id="close-policy-btn">Fechar</button>
      </div>
    </div>
  </div>
</main>

<template id="student-block-template">
  <div class="student-block" data-student-index="">
    <div class="student-block-header">
      <span>Aluno</span>
      <button type="button" class="remove-student-btn" title="Remover aluno" aria-label="Remover aluno">
        <i class="fa-solid fa-circle-minus"></i> Remover
      </button>
    </div>
    <div class="field-group">
      <label>Nome completo</label>
      <input type="text" class="student-nome" placeholder="Nome completo do aluno">
      <div class="error-text"><i class="fa-solid fa-circle-exclamation"></i> Informe o nome completo (nome e sobrenome).</div>
    </div>
    <div class="field-row">
      <div class="field-group">
        <label>Data de nascimento</label>
        <input type="date" class="student-nascimento">
        <div class="error-text"><i class="fa-solid fa-circle-exclamation"></i> Informe a data de nascimento.</div>
      </div>
      <div class="field-group">
        <label>Turma desejada</label>
        <select class="student-turma">
          <option value="">Selecione</option>
          <option>Infantil I</option>
          <option>Infantil II</option>
          <option>Infantil III</option>
          <option>Infantil IV</option>
          <option>Fundamental I - 1º ano</option>
          <option>Fundamental I - 2º ano</option>
          <option>Fundamental I - 3º ano</option>
          <option>Fundamental I - 4º ano</option>
          <option>Fundamental I - 5º ano</option>
          <option>Fundamental II - 6º ano</option>
          <option>Fundamental II - 7º ano</option>
          <option>Fundamental II - 8º ano</option>
          <option>Fundamental II - 9º ano</option>
          <option>Ensino Médio - 1ª série</option>
          <option>Ensino Médio - 2ª série</option>
          <option>Ensino Médio - 3ª série</option>
        </select>
        <div class="error-text"><i class="fa-solid fa-circle-exclamation"></i> Selecione a turma desejada.</div>
      </div>
    </div>
  </div>
</template><script src="/js/main.js"></script>
<script src="/js/review-renderer.js"></script>
<script src="/js/wizard.js"></script>
<script src="/js/policy-modal.js"></script>
</body>
</html>
