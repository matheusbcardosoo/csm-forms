        <div class="blank-line"></div>
      </div>
      <div class="blank-field">
        <div class="blank-label">Turma</div>
        <div class="blank-line" style="max-width:220px;"></div>
      </div>

      <div class="prova-block">
        <div class="prova-block-title">Avaliação perdida 1</div>
        <div class="field-row">
          <div class="blank-field">
            <div class="blank-label">Disciplina</div>
            <div class="blank-line"></div>
          </div>
          <div class="blank-field">
            <div class="blank-label">Data da avaliação perdida</div>
            <div class="blank-line"></div>
          </div>
        </div>
        <div class="choice-row">
          <span>Segmento:</span>
          <span><span class="choice-box"></span>Língua materna</span>
          <span><span class="choice-box"></span>Língua inglesa</span>
        </div>
        <div class="choice-row" style="margin-bottom:6px;">
          <span><span class="choice-box"></span>Atestado médico <span style="color:#7a8794;">(anexar atestado)</span></span>
          <span><span class="choice-box"></span>Outro motivo <span style="color:#7a8794;">(anexar comprovante — taxa de R$ 50,00)</span></span>
        </div>
        <div class="blank-field">
          <div class="blank-label">Observações (opcional)</div>
          <div class="blank-line"></div>
        </div>
      </div>

      <div class="prova-block">
        <div class="prova-block-title">Avaliação perdida 2 <span style="font-weight:400;color:#7a8794;">(se houver)</span></div>
        <div class="field-row">
          <div class="blank-field">
