<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Ficha de inscrição</title>
<%
/*
  Ficha de inscrição escolar, A4 paisagem, 15 inscritos por folha
  (08-carteirinhas §3.5), no modelo de docs/modelos/FICHA_INSCRICAO_MODELO.pdf.

  Par de client/src/componentes/PreviaFichaInscricao.tsx: mesmo objeto
  `DocFichaInscricao`, mesmo CSS. Mexeu num, mexa no outro.

  Locals: docs (DocFichaInscricao[] — uma por subpasta; a pasta inteira
  sai num PDF só) · css (string)
*/
%>
<style>
  @page { size: A4 landscape; margin: 0; }
  html, body { margin: 0; padding: 0; background: #fff; }
  .folha-ficha + .folha-ficha { break-before: page; }
  <%- css %>
</style>
</head>
<body>
<div id="pdf-root">
<% docs.forEach(function (doc) { doc.folhas.forEach(function (folha, f) { %>
  <section class="folha-ficha">
    <div class="fi-cab">
      <% if (doc.folhas.length > 1) { %><div class="fi-folha">Folha <%= f + 1 %> de <%= doc.folhas.length %></div><% } %>
      <h1>FICHA DE INSCRIÇÃO ESCOLAR</h1>
      <h2><%= doc.evento.nome %> — <%= doc.subpasta.nome %></h2>
      <p>Registro Oficial de Inscritos e Homologação da Direção</p>
      <% if (doc.evento.logo) { %><div class="fi-logo"><img src="<%= doc.evento.logo %>" alt=""></div><% } %>
    </div>

    <div class="fi-grade">
    <% folha.vagas.forEach(function (v) { var i = v.inscrito; var n = (v.numero < 10 ? '0' : '') + v.numero; %>
      <div class="fi-vaga">
        <% if (i && i.foto) { %>
          <div class="fi-foto com-foto"><img src="<%= i.foto %>" alt=""><span class="fi-numero">#<%= n %></span></div>
        <% } else { %>
          <div class="fi-foto">FOTO<br>3x4<span class="fi-numero">#<%= n %></span></div>
        <% } %>
        <div class="fi-campos">
          <div class="fi-linha"><b>Nome:</b><% if (i) { %><span class="fi-valor fi-nome"><%= i.nome %></span><% } else { %><span class="fi-pontilhado"></span><% } %></div>
          <div class="fi-linha">
            <b>Doc:</b><% if (i) { %><span class="fi-valor"><%= i.cpf %></span><% } else { %><span class="fi-pontilhado"></span><% } %>
            <b>Nasc:</b><% if (i) { %><span class="fi-nasc"><%= i.data_nascimento %></span><% } else { %><span class="fi-pontilhado" style="flex: 0 0 16mm"></span><% } %>
          </div>
        </div>
      </div>
    <% }); %>
    </div>

    <div class="fi-rodape">
      <div class="fi-bloco">
        <h3>Professor(a) responsável</h3>
        <% if (doc.subpasta.professor) { %>
          <p class="fi-texto">Nome: <span class="fi-preenchido"><%= doc.subpasta.professor %></span></p>
        <% } else { %>
          <p class="fi-texto">Nome:</p><div class="fi-pontilhado" style="flex: 0 0 auto"></div>
        <% } %>
        <div class="fi-assinatura">Assinatura do Responsável</div>
      </div>
      <div class="fi-bloco">
        <h3>Direção do colégio</h3>
        <p class="fi-texto">Atesto a veracidade das informações e documentos apresentados para os <b><%= folha.quantidade %></b> alunos inscritos acima.</p>
        <% if (doc.diretor) { %>
          <p class="fi-texto">Diretor(a): <span class="fi-preenchido"><%= doc.diretor %></span></p>
        <% } else { %>
          <p class="fi-texto">Diretor(a):</p><div class="fi-pontilhado" style="flex: 0 0 auto"></div>
        <% } %>
        <div class="fi-assinatura">Assinatura da Direção</div>
      </div>
      <div class="fi-bloco">
        <h3>Carimbo</h3>
        <div class="fi-carimbo">Espaço reservado para<b>CARIMBO DA ESCOLA</b></div>
      </div>
    </div>
  </section>
<% }); }); %>
</div>
<script>
  (function () {
    function waitForImages() {
      var imgs = document.querySelectorAll('img');
      return Promise.all(Array.prototype.map.call(imgs, function (img) {
        if (img.complete) return Promise.resolve();
        return new Promise(function (resolve) {
          img.addEventListener('load', resolve, { once: true });
          img.addEventListener('error', resolve, { once: true });
        });
      }));
    }
    waitForImages().then(function () { window.__PDF_READY__ = true; });
  })();
</script>
</body>
</html>
