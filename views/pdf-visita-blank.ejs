<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  /* Pagina isolada so pra impressao via Puppeteer — sem chrome de app,
     sem dependencia de main.js/review-renderer.js (nao ha dados a formatar,
     e um modelo em branco pra preenchimento manual). */
  html, body { margin: 0; padding: 0; background: #ffffff; }
  * { box-sizing: border-box; font-family: Inter, Segoe UI, Arial, sans-serif; }

  #pdf-root { width: 794px; background: #ffffff; padding: 10px 12px; color: #1a2530; font-size: 13px; }

  .section { border: 1px solid #0F385A; border-radius: 6px; margin-bottom: 12px; }
  .section-header {
    background: rgba(15, 56, 90, 0.06);
    border-bottom: 1px solid #0F385A;
    padding: 6px 12px;
    font-weight: 700;
    font-size: 12.5px;
    color: #0F385A;
  }
  .section-body { padding: 10px 12px; }

  .field-row { display: flex; gap: 20px; }
  .field-row .blank-field { flex: 1; }

  .blank-field { margin-bottom: 12px; }
  .blank-field:last-child { margin-bottom: 0; }
  .blank-label { font-size: 10.5px; color: #7a8794; text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 3px; }
  .blank-line { border-bottom: 1px solid #1a2530; height: 18px; }
  .blank-box { border: 1px solid #1a2530; border-radius: 4px; height: 46px; }

  .sub-block + .sub-block { border-top: 1px dashed #c7d0d8; margin-top: 10px; padding-top: 10px; }
  .sub-block-title { font-size: 11.5px; font-weight: 600; color: #0F385A; margin-bottom: 8px; }

  .choice-row { display: flex; align-items: center; gap: 24px; margin-bottom: 12px; font-size: 12.5px; }
  .choice-box { display: inline-block; width: 12px; height: 12px; border: 1px solid #1a2530; margin-right: 6px; vertical-align: -1px; }
</style>
</head>
<body>

<div id="pdf-root">
  <div style="display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid #e2e8f0;">
    <img src="/images/logo.jpg" alt="Colégio São Marcos" style="max-height:60px;display:block;justify-self:start;">
    <div style="text-align:center;">
      <h1 style="font-size:15px;font-weight:700;color:#0F385A;margin:0;white-space:nowrap;">Ficha de Registro de Visita</h1>
      <p style="font-size:10.5px;color:#7a8794;margin:2px 0 0;">Modelo para preenchimento manual</p>
    </div>
    <img src="/images/logo-brasao.png" alt="São Marcos School" style="max-height:60px;display:block;justify-self:end;">
  </div>

  <!-- ALUNOS -->
  <div class="section">
    <div class="section-header">Dados do(s) aluno(s)</div>
    <div class="section-body">
      <div class="sub-block">
        <div class="sub-block-title">Aluno 1</div>
        <div class="blank-field">
          <div class="blank-label">Nome completo</div>
          <div class="blank-line"></div>
        </div>
        <div class="field-row">
          <div class="blank-field">
            <div class="blank-label">Data de nascimento</div>
            <div class="blank-line"></div>
          </div>
          <div class="blank-field">
            <div class="blank-label">Turma desejada</div>
            <div class="blank-line"></div>
          </div>
        </div>
      </div>
      <div class="sub-block">
        <div class="sub-block-title">Aluno 2 <span style="font-weight:400;color:#7a8794;">(se houver)</span></div>
        <div class="blank-field">
          <div class="blank-label">Nome completo</div>
          <div class="blank-line"></div>
        </div>
        <div class="field-row">
          <div class="blank-field">
            <div class="blank-label">Data de nascimento</div>
            <div class="blank-line"></div>
          </div>
          <div class="blank-field">
            <div class="blank-label">Turma desejada</div>
            <div class="blank-line"></div>
          </div>
        </div>
      </div>
      <p style="font-size:10.5px;color:#7a8794;margin:10px 0 0;">Mais de dois alunos? Utilize uma folha adicional com os mesmos campos.</p>
    </div>
  </div>

  <!-- ESCOLA DE ORIGEM -->
  <div class="section">
    <div class="section-header">Escola de origem</div>
    <div class="section-body">
      <div class="field-row">
        <div class="blank-field">
          <div class="blank-label">Nome da escola</div>
          <div class="blank-line"></div>
        </div>
        <div class="blank-field">
          <div class="blank-label">Cidade / Estado</div>
          <div class="blank-line"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- RESPONSAVEIS -->
  <div class="section">
    <div class="section-header">Dados dos responsáveis</div>
    <div class="section-body">
      <div class="sub-block">
        <div class="sub-block-title">Pai</div>
        <div class="blank-field">
          <div class="blank-label">Nome completo</div>
          <div class="blank-line"></div>
        </div>
        <div class="field-row">
          <div class="blank-field">
            <div class="blank-label">WhatsApp</div>
            <div class="blank-line"></div>
          </div>
          <div class="blank-field">
            <div class="blank-label">Profissão</div>
            <div class="blank-line"></div>
          </div>
        </div>
      </div>
      <div class="sub-block">
        <div class="sub-block-title">Mãe</div>
        <div class="blank-field">
          <div class="blank-label">Nome completo</div>
          <div class="blank-line"></div>
        </div>
        <div class="field-row">
          <div class="blank-field">
            <div class="blank-label">WhatsApp</div>
            <div class="blank-line"></div>
          </div>
          <div class="blank-field">
            <div class="blank-label">Profissão</div>
            <div class="blank-line"></div>
          </div>
        </div>
      </div>
      <p style="font-size:10.5px;color:#7a8794;margin:10px 0 0;">Preencha ao menos um dos responsáveis com todos os dados solicitados.</p>
    </div>
  </div>

  <!-- INFORMACOES COMPLEMENTARES -->
  <div class="section">
    <div class="section-header">Informações complementares</div>
    <div class="section-body">
      <div class="blank-field">
        <div class="blank-label">Qual o principal motivo que trouxe a família até o Colégio São Marcos?</div>
        <div class="blank-box"></div>
      </div>
      <div class="choice-row">
        <span>Foi indicado por alguém?</span>
        <span><span class="choice-box"></span>Sim</span>
        <span><span class="choice-box"></span>Não</span>
      </div>
      <div class="blank-field">
        <div class="blank-label">Se sim, nome de quem indicou</div>
        <div class="blank-line"></div>
      </div>
      <div class="blank-field">
        <div class="blank-label">Observações (opcional)</div>
        <div class="blank-box"></div>
      </div>
    </div>
  </div>

  <div style="margin-top:16px;">
    <p style="font-size:11px;margin:0 0 30px;">Mogi das Cruzes, ____ de ________________________ de 20____.</p>
    <div style="display:flex;justify-content:space-between;gap:40px;">
      <div style="flex:1;text-align:center;">
        <div style="border-top:1px solid #1a2530;margin-bottom:6px;"></div>
        <p style="font-size:11px;color:#7a8794;margin:0;">Assinatura do Pai</p>
      </div>
      <div style="flex:1;text-align:center;">
        <div style="border-top:1px solid #1a2530;margin-bottom:6px;"></div>
        <p style="font-size:11px;color:#7a8794;margin:0;">Assinatura da Mãe</p>
      </div>
    </div>
  </div>
</div>

<script>
  // Sinaliza pro Puppeteer que pode chamar page.pdf() — so depois que as
  // logos (unicas imagens da pagina) tiverem carregado ou falhado. Mesmo
  // contrato de window.__PDF_READY__ usado em views/pdf-visita.ejs.
  (function () {
    function waitForImages() {
      var imgs = document.querySelectorAll('img');
      return Promise.all(Array.prototype.map.call(imgs, function (img) {
        if (img.complete) return Promise.resolve();
        return new Promise(function (resolve) {
          img.addEventListener('load', resolve, { once: true });
          img.addEventListener('error', resolve, { once: true });
        });
      }));
    }
    waitForImages().then(function () {
      window.__PDF_READY__ = true;
    });
  })();
</script>
</body>
</html>
